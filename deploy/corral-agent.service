[Unit]
Description=Corral agent
Documentation=https://github.com/PowerPenguini/corral
After=network-online.target docker.service zfs-mount.service
# Wants, not Requires: restarting Docker must not stop the agent; it retries
# until the engine is back.
Wants=network-online.target docker.service

[Service]
ExecStart=/usr/local/bin/corral agent -config /etc/corral/agent.yaml
Restart=always
RestartSec=2
# Tenant containers belong to Docker, not to this unit: stopping or restarting
# the agent must not stop them.
KillMode=process
RuntimeDirectory=corral
RuntimeDirectoryMode=0755
StateDirectory=corral
StateDirectoryMode=0700
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
