[Unit]
Description=Murder agent
Documentation=https://github.com/PowerPenguini/murder
After=network-online.target docker.service zfs-mount.service
# Wants, not Requires: restarting Docker must not stop the agent; it retries
# until the engine is back.
Wants=network-online.target docker.service

[Service]
ExecStart=/usr/local/bin/murder agent -config /etc/murder/agent.yaml
Restart=always
RestartSec=2
# Tenant containers belong to Docker, not to this unit: stopping or restarting
# the agent must not stop them.
KillMode=process
# A stopping agent first finishes a container replacement under way (at most
# the stop timeout plus 30 s).
TimeoutStopSec=90
RuntimeDirectory=murder
RuntimeDirectoryMode=0755
StateDirectory=murder
StateDirectoryMode=0700
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
