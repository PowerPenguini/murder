[Unit]
Description=Back up the Murder database
Documentation=https://github.com/PowerPenguini/murder
After=murder-agent.service

[Service]
Type=oneshot
# Keeps two days of hourly copies. Copy the directory off the server too:
# a backup on the disk it protects is lost with it.
ExecStart=/usr/local/bin/murder backup -keep 48 /var/backups/murder
UMask=0077
