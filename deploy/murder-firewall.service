[Unit]
Description=Murder tenant firewall
Documentation=https://github.com/PowerPenguini/murder
# Docker starts tenant containers at boot (their restart policy), before the
# agent runs: the rules must already be loaded then. After network-online,
# as Docker is, so the DNS servers are known. Wanted, not required, by
# Docker: restarting this unit to reload the rules must not restart Docker.
# The agent loads the rules again every 15 seconds and refuses to start
# without them.
Before=docker.service
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/murder firewall -config /etc/murder/agent.yaml

[Install]
WantedBy=multi-user.target docker.service
